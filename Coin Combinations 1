## Coin Combinations 1

/// Memorization 
import java.util.*;

public class Main {
    public static void main(String[] args) {
        int amount = 9;
        int[] coins = {2,3,5};
        int[] dp = new int[amount + 1]; 
        Arrays.fill(dp, -2);

        int res = find(amount,dp,coins);
        System.out.println(res);
    }

    public static int find(int amount,  int[] dp, int[] coins) {
        if(amount==0){
          return 1;
        }
        if(dp[amount]!=-2){
          return dp[amount];
        }
        int ans=0;
        for(int coin : coins){
          if(amount-coin>=0){
            ans += find(amount-coin,dp,coins);
          }
        }
        return dp[amount]=ans;
    }
}


/// tabulation 

class Solution {
    public int coinChange(int[] coins, int amount) {
        int[] dp = new int[amount + 1];
        Arrays.fill(dp, amount + 1);
        dp[0] = 0;

        for (int coin : coins) {
            for (int i = coin; i <= amount; i++) {
                dp[i] = Math.min(dp[i], dp[i - coin] + 1);
            }
        }

        return dp[amount] > amount ? -1 : dp[amount];
    }
}
